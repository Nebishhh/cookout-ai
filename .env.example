# Database Connection (Relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# API Server Configuration
PORT=3001

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# E2E Test Fixture Interception Flag (Set to true during E2E testing to bypass live API calls)
USE_GEMINI_FIXTURES=false

# Node Environment
NODE_ENV=development

# Web Frontend Client Configuration (Optional override for production API endpoint)
# VITE_API_BASE_URL=http://localhost:3001
