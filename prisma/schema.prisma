// CookOut AI - Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  email          String?   @unique
  name           String?
  passwordHash   String?
  isGuest        Boolean   @default(false)
  guestExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]
  recipes        Recipe[]
  events         Event[]
  shoppingLists ShoppingList[]
  categoryOverrides IngredientCategoryOverride[]
  pantryItems  PantryItem[]

  @@index([isGuest, guestExpiresAt])
}

// `id` stores SHA-256(rawToken), never the raw token itself — the raw token only ever
// exists in the Set-Cookie header and the browser's cookie jar, so a leaked database
// can't be replayed as a live session. See apps/api/src/auth.ts's hashToken().
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Tradeoff Note: SQLite (via Prisma) does not support native string arrays.
// dietaryTags is stored as a JSON-encoded string column (`dietaryTagsJson`) on Recipe
// and parsed/serialized at the API boundary. A normalized join table (RecipeDietaryTag)
// would be more relationally correct but is out of scope for this milestone.
model Recipe {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  baseServings    Int
  dietaryTagsJson String           @default("[]")
  createdAt       DateTime         @default(now())
  ingredients     IngredientLine[]
  steps           RecipeStep[]

  @@index([userId])
}

model IngredientLine {
  id           String @id @default(uuid())
  recipeId     String
  recipe       Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  displayName  String
  amount       Float
  unit         String
  position     Int
}

// durationAmount/durationUnit and temperatureAmount/temperatureUnit are nullable pairs —
// flat scalar columns mirroring how IngredientLine splits Quantity into amount/unit, not a
// JSON blob. NULL means "not stated for this step," not "zero" — StepDuration/StepTemperature
// are only reconstructed when both halves of a pair are present (see recipeMapper.ts).
model RecipeStep {
  id                String   @id @default(uuid())
  recipeId          String
  recipe            Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  instruction       String
  position          Int
  durationAmount    Float?
  durationUnit      String?
  temperatureAmount Float?
  temperatureUnit   String?
  notes             String?
}

// Tradeoff Note: recipeIds is a JSON-encoded string column (recipeIdsJson), mirroring
// dietaryTagsJson — unlike RecipeStep/IngredientLine, a recipeId carries no per-line data
// beyond order, which a JSON array already preserves, so a join table adds nothing.
// "Recompute live" also means Event tolerates ids that no longer resolve to a Recipe
// (filtered out at read time) rather than depending on DB referential integrity.
// serveTimeMinutes is wall-clock minutes from midnight (0..1439), NOT a DateTime — "serve at
// 6pm" is a wall-clock intent, not an instant, so storing it this way keeps timezone conversion
// out of every read. NULL means the host hasn't asked for a cook schedule. See the domain
// Event's own note and events/cookSchedule.ts.
model Event {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  totalGuests      Int
  vegetarianCount  Int           @default(0)
  veganCount       Int           @default(0)
  recipeIdsJson    String        @default("[]")
  serveTimeMinutes Int?
  createdAt        DateTime      @default(now())
  shoppingList     ShoppingList?

  @@index([userId])
}

// eventId is nullable + @unique: usable standalone (null) or attached to at most one
// Event. Deleting the Event cascades to its linked ShoppingList; the reverse never happens.
model ShoppingList {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  eventId   String?            @unique
  event     Event?             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  items     ShoppingListItem[]

  @@index([userId])
}

// Tradeoff Note: sourceRecipeIds is stored as a JSON-encoded string column
// (sourceRecipeIdsJson), same rationale as Event.recipeIdsJson above.
model ShoppingListItem {
  id                  String       @id @default(uuid())
  shoppingListId      String
  shoppingList        ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
  ingredientId        String
  displayName         String
  amount              Float
  unit                String
  sourceRecipeIdsJson String       @default("[]")
  checked             Boolean      @default(false)
  position            Int
}

// A user-triggered correction to categorizeIngredient()'s keyword-heuristic result, keyed
// per-user by ingredientId (not scoped to one recipe or list) — category is already treated
// as a pure function of ingredient identity everywhere else, so a correction here is applied
// wherever that ingredientId appears *for that user*, not persisted onto individual
// ShoppingListItem rows. Was globally keyed by ingredientId alone before multi-tenancy;
// userId was added to the uniqueness key so each user corrects their own catalog.
model IngredientCategoryOverride {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredientId String
  category     String
  updatedAt    DateTime @updatedAt

  @@unique([userId, ingredientId])
}

// A per-user, standing on-hand quantity per ingredient — one fact per (userId, ingredientId),
// same shape as IngredientCategoryOverride above, resolved server-side and subtracted from
// every generated shopping list (preview, save, and event-linked regenerate) rather than
// scoped to one build. Flat amount/unit columns, matching ShoppingListItem's precedent, not a
// Quantity JSON blob. Was globally keyed by ingredientId alone before multi-tenancy.
model PantryItem {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredientId String
  displayName  String
  amount       Float
  unit         String
  updatedAt    DateTime @updatedAt

  @@unique([userId, ingredientId])
}
